rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, create, update: if owner(uid);
      allow delete: if owner(uid);

      match /progress/{subjectId} {
        allow read, create, update: if owner(uid);
        allow delete: if owner(uid);
      }
    }

    // Phase 1 accepts authenticated client results. Phase 3 must replace this
    // with server-created results after score validation.
    match /gameResults/{resultId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /leaderboard/{uid} {
      allow read: if true;
      // Transitional Phase 1 write. Lock this after submitGameResult is
      // deployed on Blaze; then only the Cloud Function should write scores.
      allow create, update: if owner(uid) && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /dailyChallenges/{challengeId} {
      allow read: if true;
      allow write: if false;
    }

    match /content/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Content/admin collections are intentionally locked until Phase 2 roles exist.
    match /{document=**} { allow read, write: if false; }
  }
}
